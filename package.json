{
  "name": "dsh-chat-source-tracer",
  "version": "0.3.1",
  "description": "Trace AI answer sources in DeepSeek Harness chats, search across sessions, save excerpts and decisions, and ask follow-up questions with original quotes.",
  "type": "module",
  "license": "MIT",
  "author": "dsh-chat-source-tracer contributors",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "chat-history",
    "chat-search",
    "source-tracing",
    "source-attribution",
    "provenance",
    "evidence",
    "cross-session-search",
    "research",
    "note-taking",
    "溯源",
    "对话检索"
  ],
  "homepage": "https://github.com/Milaro001/dsh-chat-source-tracer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Milaro001/dsh-chat-source-tracer.git"
  },
  "bugs": {
    "url": "https://github.com/Milaro001/dsh-chat-source-tracer/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "retrieval.js",
    "related.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "SUPPORT.md",
    "PUBLISHING.md",
    "LICENSE",
    "docs/preview.jpg",
    "docs/TESTING.md",
    "screenshots.json"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.js && node --check client.js && node --check retrieval.js && node --check related.js",
    "benchmark": "node scripts/benchmark.mjs",
    "preview": "node tests/serve.mjs"
  }
}
